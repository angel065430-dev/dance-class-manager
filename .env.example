VITE_SUPABASE_URL=http://127.0.0.1:18081
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Isolated local E2E only. Never commit real production credentials.
E2E_ADMIN_EMAIL=local-e2e-admin@example.invalid
E2E_ADMIN_PASSWORD=replace-with-local-e2e-admin-password

# Enables the real concurrent RPC tests against local Supabase.
LOCAL_SUPABASE_URL=http://127.0.0.1:18081
LOCAL_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
